# mail2 LLM（DeepSeek）配置
api_key: "sk-xxxxxxxx"
base_url: "https://api.deepseek.com"
model: "deepseek-chat"
# 单次请求超时（秒）
timeout_secs: 60

# Agent 模式（新邮件处理走 tool call；失败自动降级旧固定 prompt 路径）
agent:
  # true = 收到新邮件后由大模型 Agent 自主调用工具（读完整邮件/增查分类/建事项）；
  # 删除/修改类操作会生成审批申请，需在 Web“审批”页批准。
  enabled: true
  # Agent 循环最大轮数（每轮可含多次工具调用）
  max_tool_rounds: 8

# 邮件分类类型（可增删改；id 用于内部标识，label 用于提醒主题【类型/...】与界面展示）
# create_item: true 表示该类邮件自动创建事务（item），进入待办管理
# 待办口径：只有「需要本人亲自行动且有明确时间」的邮件才建待办——
#   面试/笔试/测评/预约/材料提交 等；宣讲会/双选会/网申推荐/投递邀请属于招聘推广
#   （career_promo），只做通知、永不建待办。
# 注意：Agent 运行期新建的分类默认 create_item=false（需要建项时由 Agent 显式调用 create_item）。
# 运行期分类存于数据库；此处为首次启动的种子分类。
categories:
  - { id: todo,          label: "事务预约/待办", create_item: true }
  - { id: interview,     label: "面试",         create_item: true }
  - { id: assessment,    label: "测评",         create_item: true }
  - { id: written_test,  label: "笔试",         create_item: true }
  - { id: notification,  label: "通知类",       create_item: false }
  - { id: career_promo,  label: "招聘推广",     create_item: false }
  - { id: conversation,  label: "对话交流型",   create_item: false }
  - { id: misc,          label: "其他",         create_item: false }
